{
  "expo": {
    "name": "BACUA",
    "slug": "bacua",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bacua",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070709",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "userInterfaceStyle": "dark"
    },
    "android": {
      "userInterfaceStyle": "dark",
      "edgeToEdgeEnabled": true,
      "package": "com.bacua.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      "@react-native-community/datetimepicker"
    ]
  }
}
